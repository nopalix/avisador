# ============================================================
# AVISADOR — Variables de entorno
# Copia este archivo como .env y completa los valores
# ============================================================

# --- App ---
DEBUG=false

# --- Panel admin (HTTPBasic) — cámbialas antes de usar en red ---
ADMIN_USER=admin
ADMIN_PASSWORD=Admin

# --- Base de datos ---
# Por defecto usa SQLite local. Puedes cambiar a PostgreSQL si lo necesitas.
# DATABASE_URL=sqlite:///./avisador.db

# --- Email (smtplib) ---
# Pon EMAIL_HABILITADO=true y completa los datos para activar
EMAIL_HABILITADO=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=tu_correo@gmail.com
EMAIL_PASSWORD=tu_contrasena_de_app
EMAIL_DESTINATARIO=destino@ejemplo.com

# --- Telegram ---
# Pon TELEGRAM_HABILITADO=true y completa el token y chat_id
TELEGRAM_HABILITADO=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Google Calendar ---
# Pon CALENDAR_HABILITADO=true y especifica las rutas de credenciales OAuth2
CALENDAR_HABILITADO=false
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json

# --- Recordatorios (scheduler de avisos de tareas próximas a vencer) ---
# RECORDATORIOS_HABILITADO=true activa la revisión periódica.
# RECORDATORIO_ANTICIPACION_HORAS: lista separada por comas de horas antes del límite
RECORDATORIOS_HABILITADO=true
RECORDATORIO_INTERVALO_MINUTOS=5
RECORDATORIO_ANTICIPACION_HORAS=24,1

# --- Whisper (transcripción de audio) ---
# Pon WHISPER_HABILITADO=true para activar (requiere: pip install openai-whisper)
# Modelos disponibles: tiny | base | small | medium | large
WHISPER_HABILITADO=false
WHISPER_MODELO=base
